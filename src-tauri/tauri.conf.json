{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraLine",
  "version": "0.1.0",
  "identifier": "com.auraline.stealthwidget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "AuraLine",
        "width": 440,
        "height": 84,
        "minWidth": 200,
        "minHeight": 32,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
